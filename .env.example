# Local development values only; replace for any deployed environment.
PORT=3000
POSTGRES_PORT=5433
POSTGRES_PASSWORD=klaro-local-development
DATABASE_URL=postgresql://klaro:klaro-local-development@127.0.0.1:5433/klaro
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380

APP_ORIGIN=http://localhost:4200
# Set both to enable login; no provider credentials are included here.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOW_LOOPBACK_HTTP=false

# Exact redirect URLs returned by identity.getRedirectURL('klaro').
EXTENSION_CALLBACKS=

# Explicit panel origins allowed by Socket.IO (comma-separated).
EXTENSION_ORIGINS=
# double is a synthetic development provider; forbidden in production.
AI_PROVIDER=
# Optional server-only JSON containing active and immutable policies.
AI_POLICY_FILE=
# Optional server-only budget JSON; empty keeps a zero paid-operation budget.
AI_BUDGET_FILE=
OPENAI_API_KEY=
# Supply a stable, random 32-byte secret encoded as 64 hex characters.
OPERATION_HMAC_KEY=

# Deployment-reviewed provider retention statement; no zero-retention assumption.
PROVIDER_RETENTION_NOTICE=

# Global paid-operation stop, persistent until an authenticated operator enables it.
AI_ENABLED=true
# Separate server-only 32-byte hex operator credential and audit identity.
ADMIN_TOKEN=
ADMIN_ACTOR=

# Durable encrypted deletion journal, stored outside PostgreSQL backup snapshots.
DELETION_JOURNAL_FILE=
DELETION_JOURNAL_KEY=
# HTTPS deployment: certificate files mounted read-only; never commit keys.
TLS_CERT_FILE=
TLS_KEY_FILE=

# AES-256-GCM encrypted PostgreSQL backups; keep key separate from backup files.
BACKUP_KEY=

# Offline real-model evaluator. evaluation:plan sends nothing; evaluation:run
# enforces the full-run bound before dispatch and never retries automatically.
# Separate from AI_POLICY_FILE: the evaluator accepts an unreviewed candidate.
EVALUATION_POLICY_FILE=./deployment/policies.openai.candidate.json
# Integer micro-USD: 1000000 = USD 1. 0 declares no approved paid evaluation budget.
EVALUATION_MAX_COST_MICROUSD=0
# Server-only JSON mapping uk/de/en/vi to human reviewer identifiers.
# Naming a reviewer does not constitute completed review or sign-off.
EVALUATION_REVIEWERS_FILE=

# Docker deployment: host policy JSON mounted read-only as AI_POLICY_FILE.
# Empty uses deployment/policies.disabled.json; real-model policy is configured separately.
MODEL_POLICY_FILE=
# Docker host budget JSON; empty mounts deployment/budgets.disabled.json.
MODEL_BUDGET_FILE=
